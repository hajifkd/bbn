"""Hybrid Boltzmann/Fokker--Planck stationary cascade solver."""

from dataclasses import dataclass

import numpy as np
from scipy.sparse import lil_matrix
from scipy.sparse.linalg import spsolve

from .config import CascadeConfig
from .finite_volume import FiniteVolumeCollision
from .inverse_compton_fp import chang_cooper_weight
from .inverse_compton_split import build_inverse_compton_moments
from .processes import loss_rates
from .published import published_spectrum
from .sources import MonochromaticPhotonSource


@dataclass(frozen=True)
class CascadeSpectrum:
    energy: np.ndarray
    photon: np.ndarray
    electron: np.ndarray
    rates: dict[str, np.ndarray]
    diagnostics: dict[str, float]

    def to_csv(self, path) -> None:
        names = list(self.rates)
        data = np.column_stack(
            [self.energy, self.photon, self.electron]
            + [self.rates[name] for name in names]
        )
        np.savetxt(
            path,
            data,
            delimiter=",",
            header=",".join(["energy_GeV", "photon_GeV2", "electron_GeV2"] + names),
            comments="",
        )


class CascadeSolver:
    def __init__(self, config: CascadeConfig):
        self.config = config

    def solve(self, source=None):
        source = source or MonochromaticPhotonSource(self.config.maximum_energy)
        if not np.isclose(source.energy, self.config.maximum_energy):
            raise ValueError("source energy must equal config.maximum_energy")
        energy = np.geomspace(
            self.config.minimum_energy,
            self.config.maximum_energy,
            self.config.grid_size,
        )
        if self.config.mode == "published-fit":
            rates = loss_rates(
                energy,
                self.config.temperature,
                self.config.eta_baryon,
                self.config.helium_mass_fraction,
            )
            photon = published_spectrum(
                energy,
                self.config.temperature,
                source.energy,
                source.energy_injection_rate,
            )
            return CascadeSpectrum(
                energy, photon, np.zeros_like(photon), rates, {"published_fit": 1.0}
            )
        return self._solve_hybrid(energy, source)

    def _solve_hybrid(self, energy, source):
        config = self.config
        collision = FiniteVolumeCollision(
            config.temperature,
            config.eta_baryon,
            config.helium_mass_fraction,
            config.quadrature_order,
        ).build_finite_volume(energy)
        moments = build_inverse_compton_moments(
            energy,
            config.temperature,
            config.soft_fraction,
            config.quadrature_order,
            config.background_cutoff_over_temperature,
        )

        transitions = collision.transitions.copy()
        transitions[0, 1] = (
            moments.soft_photon_kernel + moments.hard_photon_kernel
        )
        transitions[1, 1] = moments.hard_electron_kernel
        photon_loss = collision.photon_loss

        full, full_diag = self._linear_solve(
            energy,
            collision.boundaries,
            photon_loss,
            moments.hard_loss,
            transitions,
            moments.drift,
            moments.diffusion if config.include_energy_diffusion else np.zeros_like(moments.diffusion),
            source,
        )
        drift_only, _ = self._linear_solve(
            energy,
            collision.boundaries,
            photon_loss,
            moments.hard_loss,
            transitions,
            moments.drift,
            np.zeros_like(moments.diffusion),
            source,
        )
        scale = np.maximum(np.abs(full), np.max(np.abs(full)) * 1e-30)
        diffusion_difference = float(np.max(np.abs(full - drift_only) / scale))
        consistency = np.divide(
            np.abs(moments.drift - moments.soft_energy_from_photons),
            np.maximum(moments.drift, np.finfo(float).tiny),
        )
        rates = dict(collision.components)
        rates["inverse_compton_hard"] = moments.hard_loss
        diagnostics = {
            **full_diag,
            "kernel_quadrature_order": float(config.quadrature_order),
            "soft_fraction": config.soft_fraction,
            "drift_diffusion_max_relative_difference": diffusion_difference,
            "soft_energy_moment_max_relative_error": float(np.max(consistency)),
            "finite_volume": 1.0,
            "hybrid_fokker_planck": 1.0,
        }
        return CascadeSpectrum(energy, full[0], full[1], rates, diagnostics)

    def _linear_solve(
        self,
        energy,
        boundaries,
        photon_loss,
        electron_hard_loss,
        transitions,
        drift,
        diffusion,
        source,
    ):
        n = len(energy)
        size = 2 * n
        widths = np.diff(boundaries)
        operator = lil_matrix((size, size), dtype=float)

        def index(species, cell):
            return species * n + cell

        losses = (photon_loss, electron_hard_loss)
        for species in range(2):
            for parent in range(n):
                operator[index(species, parent), index(species, parent)] -= losses[species][parent]
                for outgoing_species in range(2):
                    values = transitions[outgoing_species, species, :, parent]
                    nonzero = np.flatnonzero(values)
                    for child in nonzero:
                        operator[
                            index(outgoing_species, child), index(species, parent)
                        ] += values[child]

        # Internal Chang--Cooper fluxes. A=-b and B=D/2.
        for face in range(1, n):
            low, high = face - 1, face
            spacing = energy[high] - energy[low]
            bface = 0.5 * (drift[low] + drift[high])
            dface = 0.5 * (diffusion[low] + diffusion[high])
            A, B = -bface, 0.5 * dface
            delta = chang_cooper_weight(A, B, spacing)
            coeff_low = A * (1 - delta) + B / spacing
            coeff_high = A * delta - B / spacing
            e_low, e_high = index(1, low), index(1, high)
            # f=N/DeltaE; low cell receives -J, high cell receives +J.
            operator[e_low, e_low] -= coeff_low / widths[low]
            operator[e_low, e_high] -= coeff_high / widths[high]
            operator[e_high, e_low] += coeff_low / widths[low]
            operator[e_high, e_high] += coeff_high / widths[high]

        # Low-energy outflow; upper boundary has zero flux.
        operator[index(1, 0), index(1, 0)] += -drift[0] / widths[0]
        source_vector = np.zeros(size)
        source_vector[index(0, n - 1)] = source.number_injection_rate
        populations = spsolve((-operator).tocsr(), source_vector)
        spectra = np.vstack((populations[:n], populations[n:])) / widths
        maximum = max(float(np.max(np.abs(spectra))), np.finfo(float).tiny)
        tolerance = 1e-10 * maximum
        negative = spectra < -tolerance
        if np.any(negative):
            raise RuntimeError(
                f"hybrid FP solve produced {np.count_nonzero(negative)} negative bins; "
                f"minimum={np.min(spectra):.6e}"
            )
        tiny_negative = (spectra < 0) & ~negative
        spectra[tiny_negative] = 0
        diagnostics = {
            "injected_energy_rate": source.energy_injection_rate,
            "minimum_spectrum_value": float(np.min(spectra)),
            "negative_bin_count": float(np.count_nonzero(negative)),
            "roundoff_bin_count": float(np.count_nonzero(tiny_negative)),
        }
        return spectra, diagnostics
