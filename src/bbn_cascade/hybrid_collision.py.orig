"""Non-IC Boltzmann kernels used alongside the IC Fokker--Planck operator."""

from dataclasses import dataclass

import numpy as np
from numpy.polynomial.legendre import leggauss

from .constants import ALPHA, M_E, PI, R_E
from .kernels import (
    CollisionIntegrals,
    bethe_heitler_differential,
    compton_kernel,
)
from .processes import klein_nishina_total, nuclear_pair_total


@dataclass(frozen=True)
class HybridBoltzmannSystem:
    photon_loss: np.ndarray
    transitions: np.ndarray
    components: dict[str, np.ndarray]
    boundaries: np.ndarray


class HybridBoltzmannCollision(CollisionIntegrals):
    """Build only gamma<-gamma and e<-gamma kernels.

    Electron-parent IC kernels are intentionally absent because the hybrid
    moment integrator supplies their soft/hard split.
    """

    def _photon_parent_differential(self, outgoing, incoming):
        result = np.zeros(2)
        ratio = outgoing / incoming
        # Eq. (31) is a low-energy approximation; Eq. (32) cuts it off.
        if incoming <= M_E**2 / self.T:
            result[0] = (
                1112
                / (10125 * PI)
                * ALPHA**2
                * R_E**2
                * M_E**-6
                * incoming**2
                * (1 - ratio + ratio**2) ** 2
                * self.moment
            )
        result[0] += compton_kernel(outgoing, incoming, self.ne)
        result[1] = compton_kernel(
            incoming + M_E - outgoing, incoming, self.ne
        )
        result[1] += (
            2 * self.nz2 * bethe_heitler_differential(outgoing, incoming)
        )
        result[1] += self.double_pair_electron(outgoing, incoming)
        return result

    def build_hybrid(self, energy):
        energy = np.asarray(energy, dtype=float)
        n = len(energy)
        pp = (
            1946
            / (50625 * PI)
            * ALPHA**2
            * R_E**2
            * M_E**-6
            * energy**3
            * self.moment
        )
        compton = self.ne * klein_nishina_total(energy)
        nuclear_pair = self.nz2 * nuclear_pair_total(energy)
        double_pair = np.array([self.double_pair_rate(e) for e in energy])
        photon_loss = pp + compton + nuclear_pair + double_pair
        transitions = np.zeros((2, 2, n, n))
        boundaries = np.empty(n + 1)
        boundaries[1:-1] = np.sqrt(energy[:-1] * energy[1:])
        boundaries[0], boundaries[-1] = energy[0], energy[-1]
        nodes, weights = leggauss(max(6, self.order // 2))

        for parent, incoming in enumerate(energy):
            for child in range(parent + 1):
                low, high = boundaries[child], min(boundaries[child + 1], incoming)
                if high <= low:
                    continue
                a, b = np.log(low), np.log(high)
                points = np.exp((b - a) * nodes / 2 + (a + b) / 2)
                integrated = np.zeros(2)
                for point, weight in zip(points, weights):
                    integrated += (
                        weight
                        * point
                        * self._photon_parent_differential(point, incoming)
                    )
                transitions[:, 0, child, parent] = integrated * (b - a) / 2

        components = {
            "photon_photon": pp,
            "compton": compton,
            "nuclear_pair": nuclear_pair,
            "double_pair": double_pair,
        }
        return HybridBoltzmannSystem(
            photon_loss, transitions, components, boundaries
        )
